cabal-version: 2.4
name: browser-runtime
version: 0.1.0.0
synopsis: Shared JSON entry point for native and browser workbench execution
build-type: Simple

common settings
  default-language: Haskell2010
  ghc-options: -Wall -Werror
  build-depends: base >=4.14 && <5, aeson, bytestring, text

library
  import: settings
  hs-source-dirs: src
  exposed-modules: Workbench.Runtime
  build-depends: ontology-language

executable workbench-runtime
  import: settings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: browser-runtime

executable workbench-wasm
  import: settings
  hs-source-dirs: app
  main-is: Browser.hs
  build-depends: browser-runtime
  if arch(wasm32)
    build-depends: ghc-experimental
    ghc-options: -no-hs-main -optl-mexec-model=reactor -optl-Wl,--export=workbench_run
  else
    buildable: False
